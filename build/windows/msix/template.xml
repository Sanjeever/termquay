<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="termquay"
        Arguments=""
        InstallLocation="C:\Program Files\TermQuay">
    </Installer>
    <PackageInformation
        PackageName="TermQuay"
        PackageDisplayName="TermQuay"
        PublisherName="CN=TermQuay"
        PublisherDisplayName="TermQuay"
        Version="1.4.7.0"
        PackageDescription="TermQuay 远程连接工作台">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.termquay.app"
                Description="TermQuay 远程连接工作台"
                DisplayName="TermQuay"
                ExecutableName="termquay"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>TermQuay</DisplayName>
            <PublisherDisplayName>TermQuay</PublisherDisplayName>
            <Description>TermQuay 远程连接工作台</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="termquay.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
