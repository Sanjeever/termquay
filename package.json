{
  "name": "termquay-workbench",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/wails.mjs task dev",
    "build": "node scripts/wails.mjs build",
    "package": "node scripts/wails.mjs task package",
    "wails:doctor": "node scripts/wails.mjs doctor",
    "bindings": "node scripts/wails.mjs generate bindings -ts -i",
    "task": "node scripts/wails.mjs task",
    "wails": "node scripts/wails.mjs",
    "dev:frontend": "pnpm --dir frontend dev",
    "build:frontend": "pnpm --dir frontend build",
    "check": "pnpm --dir frontend check",
    "test": "node scripts/test.mjs",
    "lint": "pnpm lint:frontend && pnpm lint:go",
    "lint:frontend": "pnpm --dir frontend lint",
    "lint:go": "go vet ./...",
    "format": "pnpm --dir frontend format && node scripts/go-format.mjs --write",
    "format:check": "pnpm --dir frontend format:check && node scripts/go-format.mjs",
    "test:ui": "pnpm --dir frontend test:ui",
    "verify": "pnpm format:check && pnpm lint:frontend && pnpm build:frontend && pnpm lint:go && pnpm test && go test ./... && pnpm test:ui"
  }
}
